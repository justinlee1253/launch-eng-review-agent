{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "progress",
    "reviewed_head",
    "reviewed_files",
    "reviewed_documents",
    "lenses",
    "requests",
    "findings"
  ],
  "properties": {
    "progress": {
      "type": "string",
      "maxLength": 12000,
      "description": "Private checkpoint of concrete conclusions, contracts, unresolved questions and remaining checks. No hidden reasoning trace. Empty on a completed review."
    },
    "status": {
      "type": "string",
      "enum": [
        "needs_evidence",
        "complete",
        "incomplete"
      ]
    },
    "summary": {
      "type": "string"
    },
    "reviewed_head": {
      "type": "string"
    },
    "reviewed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewed_documents": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Exact document and document_aliases keys actually reviewed, including reconstructed sources. Do not acknowledge documents only received but not reviewed."
    },
    "lenses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "correctness",
          "security",
          "operability"
        ]
      }
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo",
          "ref",
          "kind",
          "path"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "enum": [
              "ROKT/launch-engineering"
            ]
          },
          "ref": {
            "type": "string",
            "anyOf": [
              {"type": "string", "enum": ["head", "base", "main"]},
              {"type": "string", "pattern": "^pr/[1-9][0-9]*$"}
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "tree",
              "context"
            ]
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blocking",
          "severity",
          "path",
          "side",
          "line",
          "title",
          "scenario",
          "impact",
          "evidence",
          "fix"
        ],
        "properties": {
          "blocking": {
            "type": "boolean"
          },
          "severity": {
            "type": "string",
            "enum": [
              "dangerous",
              "should_fix"
            ]
          },
          "path": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": [
              "RIGHT",
              "LEFT"
            ]
          },
          "line": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "scenario": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    }
  }
}
