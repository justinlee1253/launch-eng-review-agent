{
  "type": "object",
  "additionalProperties": false,
  "required": ["corrections", "unresolved"],
  "properties": {
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_index", "path", "side", "line", "evidence"],
        "properties": {
          "finding_index": {"type": "integer", "minimum": 0},
          "path": {"type": "string"},
          "side": {"type": "string", "enum": ["LEFT", "RIGHT"]},
          "line": {"type": "integer", "minimum": 1},
          "evidence": {"type": "string"}
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_index", "reason"],
        "properties": {
          "finding_index": {"type": "integer", "minimum": 0},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
